# CodeCrack Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to GitHub!

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=codecrack
DB_USERNAME=codecrack
DB_PASSWORD=CodeCrack@2026

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT
JWT_SECRET=CodeCrackJWT@SuperSecret@2026@MinLength256Bits

# Spring
SPRING_PROFILES_ACTIVE=prod
